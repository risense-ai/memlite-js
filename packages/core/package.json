{
  "name": "@rsrsai/memlite",
  "version": "0.3.1",
  "description": "Embeddable local memory engine (TypeScript). Data-compatible with respire-memlite (Rust).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "memory",
    "memlite",
    "bm25",
    "embedding",
    "local-first",
    "ai-memory"
  ],
  "author": "risense",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/risense-ai/memlite-js.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/risense-ai/memlite-js/issues"
  },
  "homepage": "https://github.com/risense-ai/memlite-js#readme",
  "peerDependencies": {
    "fs-ext": "^2.1.1"
  },
  "peerDependenciesMeta": {
    "fs-ext": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
